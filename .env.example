# Copy to .env and fill in. .env is git-ignored, never commit real keys.
MONGODB_URI=mongodb://localhost:27017/forkcast?directConnection=true
REDIS_HOST=localhost
REDIS_PORT=6379
# 32+ random bytes, e.g. from: openssl rand -base64 48
JWT_SECRET=
# Gemini API key from https://aistudio.google.com/apikey (free tier). Enables semantic dish search.
GEMINI_API_KEY=
